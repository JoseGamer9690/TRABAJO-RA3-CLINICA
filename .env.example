# Cadena de conexión de PostgreSQL (Neon la agrega sola al conectarla desde Vercel > Storage)
DATABASE_URL=postgres://usuario:password@host/neondb?sslmode=require
# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Contraseña inicial de los usuarios de demostración
SEED_PASSWORD=Huellas#2026
# (Opcional) SMTP para enviar el correo de recuperación. Gmail: usa una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=Huellas del Bravo <tu_correo@gmail.com>
